    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "queuetrack",
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "c424eebd-fc1f-4d1d-a0fc-599e1e12f914"
      }
    }
